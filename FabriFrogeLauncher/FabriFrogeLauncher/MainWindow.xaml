<Window x:Class="FabriFrogeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FabriFroge Launcher"
        Height="520" Width="820"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- Rounded dark card -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#B0121620"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Modern rounded button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#CC1F2937"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0232F42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text style on dark -->
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Slim pill action button -->
        <Style x:Key="PillActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: BLACK text on WHITE background (dropdown + selection) -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ComboBox items: BLACK on WHITE -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FFEDEDED"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFDCDCDC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- NO hover/press chrome (for play pill inner clickable areas) -->
        <Style x:Key="NoChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NO hover/press chrome (for play menu ToggleButton) -->
        <Style x:Key="NoChromeToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Rounded window shell -->
    <Border CornerRadius="20"
            Background="#FF0F1014"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            ClipToBounds="True"
            SnapsToDevicePixels="True">

        <Grid>

            <!-- Background WebP frame target -->
            <Image x:Name="BgAnim"
                   Stretch="UniformToFill"
                   SnapsToDevicePixels="True"/>

            <!-- Top Titlebar (draggable) -->
            <Grid Height="44"
                  VerticalAlignment="Top"
                  Background="#22000000"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FabriFroge Launcher"
                           Foreground="#EEFFFFFF"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Content="—"
                            Width="34"
                            Height="28"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="Minimize_Click"
                            Margin="0,0,6,0"/>
                    <Button Content="□"
                            Width="34"
                            Height="28"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="Maximize_Click"
                            Margin="0,0,6,0"/>
                    <Button Content="✕"
                            Width="34"
                            Height="28"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Overlay layout -->
            <Grid Margin="0,44,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="14">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="FabriFroge Launcher"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="FabriFroge Cobblemon 1.7"
                                       Foreground="#AAFFFFFF"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- Install folder -->
                        <Border Grid.Row="1"
                                CornerRadius="12"
                                Background="#66111827"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                Padding="10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Install folder"
                                           Foreground="#CCFFFFFF"
                                           FontSize="12"/>

                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="InstallPathBox"
                                             Height="30"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,8,0"/>

                                    <Button x:Name="BrowseButton"
                                            Grid.Column="1"
                                            Content="Browse"
                                            Height="30"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Click="Browse_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ONLY showing the changed section to avoid breaking anything else -->

                        <!-- Account row -->
                        <Border Grid.Row="2"
        CornerRadius="12"
        Background="#66111827"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        Padding="10"
        Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Signed in as: " Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="SignedInAsText" Foreground="White" FontSize="12"/>
                                </StackPanel>

                                <!-- ✅ UPDATED BUTTON ROW (3 buttons) -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="SignInButton"
                    Grid.Column="0"
                    Content="Sign In"
                    Style="{StaticResource PillActionButtonStyle}"
                    Click="SignInButton_Click"/>

                                    <Button x:Name="SignOutButton"
                    Grid.Column="2"
                    Content="Sign Out"
                    Style="{StaticResource PillActionButtonStyle}"
                    Click="SignOutButton_Click"/>

                                    <Button x:Name="WikiButton"
                    Grid.Column="4"
                    Content="Wiki"
                    Style="{StaticResource PillActionButtonStyle}"
                    Click="WikiButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Version + progress -->
                        <Border Grid.Row="3"
                                CornerRadius="12"
                                Background="#66111827"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                Padding="10"
                                Margin="0,0,0,8">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Installed" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="InstalledVersionText"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Latest" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="LatestVersionText"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="Progress"
                                             Grid.Row="1"
                                             Height="12"
                                             Margin="0,10,0,0"
                                             Minimum="0" Maximum="100"/>

                                <TextBlock x:Name="ProgressText"
                                           Grid.Row="2"
                                           Margin="0,8,0,0"
                                           Foreground="#DDFFFFFF"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="3" Text="" Height="2"/>
                            </Grid>
                        </Border>

                        <!-- Spacer row -->
                        <Border Grid.Row="4" Background="Transparent"/>

                        <!-- Bottom actions -->
                        <Border Grid.Row="5"
                                Margin="0,10,0,0"
                                CornerRadius="18"
                                Background="#C0101420"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                Padding="12"
                                ClipToBounds="False">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Play pill -->
                                <Border x:Name="PlayPill"
                                        Grid.Row="0"
                                        Height="56"
                                        MinHeight="56"
                                        Background="#FFFFE700"
                                        CornerRadius="28"
                                        Padding="16,10"
                                        Margin="0"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True"
                                        ClipToBounds="False">
                                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left circle -->
                                        <Border Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="18"
                                                Background="#66FFFFFF"
                                                Margin="0,0,12,0"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True"
                                                ClipToBounds="False">
                                            <Button x:Name="PlayIconButton"
                                                    Style="{StaticResource NoChromeButton}"
                                                    Cursor="Hand"
                                                    Click="PlayButton_Click"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center">
                                                <Viewbox Width="14" Height="14" Stretch="Uniform">
                                                    <Path Fill="Black" Data="M 0 0 L 1 0.5 L 0 1 Z"/>
                                                </Viewbox>
                                            </Button>
                                        </Border>

                                        <!-- Center label -->
                                        <Button x:Name="PlayButton"
                                                Grid.Column="1"
                                                Style="{StaticResource NoChromeButton}"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Click="PlayButton_Click">
                                            <TextBlock Text="Play"
                                                       Foreground="Black"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"/>
                                        </Button>

                                        <!-- RIGHT BUTTON -->
                                        <Border Grid.Column="2"
                                                Width="36"
                                                Height="36"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                CornerRadius="18"
                                                Background="#FF0F172A"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                Margin="12,0,0,0"
                                                Padding="1"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True"
                                                ClipToBounds="False">
                                            <ToggleButton x:Name="PlayMenuButton"
                                                          Style="{StaticResource NoChromeToggle}"
                                                          Cursor="Hand"
                                                          Click="PlayMenuButton_Click"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          Margin="0"
                                                          Padding="0">
                                                <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                    <Canvas Width="16" Height="16">
                                                        <Rectangle Width="14" Height="2" RadiusX="1" RadiusY="1" Fill="White" Canvas.Left="1" Canvas.Top="3"/>
                                                        <Rectangle Width="14" Height="2" RadiusX="1" RadiusY="1" Fill="White" Canvas.Left="1" Canvas.Top="7"/>
                                                        <Rectangle Width="14" Height="2" RadiusX="1" RadiusY="1" Fill="White" Canvas.Left="1" Canvas.Top="11"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </ToggleButton>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Popup menu -->
                                <Popup x:Name="PlayMenuPopup"
                                       PlacementTarget="{Binding ElementName=PlayPill}"
                                       Placement="Top"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       VerticalOffset="-8">
                                    <Border x:Name="PlayMenuPopupBorder"
                                            CornerRadius="14"
                                            Background="#E0101420"
                                            BorderBrush="#33FFFFFF"
                                            BorderThickness="1"
                                            Padding="10"
                                            Width="260">
                                        <StackPanel>
                                            <Button x:Name="CheckUpdatesButton"
                                                    Content="Check Updates"
                                                    Style="{StaticResource PillActionButtonStyle}"
                                                    Margin="0,0,0,8"
                                                    Click="CheckUpdatesButton_Click"/>
                                            <Button x:Name="InstallButton"
                                                    Content="Install / Update"
                                                    Style="{StaticResource PillActionButtonStyle}"
                                                    Margin="0,0,0,8"
                                                    Click="InstallButton_Click"/>
                                            <Button x:Name="RepairButton"
                                                    Content="Repair"
                                                    Style="{StaticResource PillActionButtonStyle}"
                                                    Margin="0,0,0,8"
                                                    Click="RepairButton_Click"/>

                                            <Button x:Name="SwapAccountsButton"
                                                    Content="Swap Accounts"
                                                    Style="{StaticResource PillActionButtonStyle}"
                                                    Click="SwapAccountsButton_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Status text -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="JavaRamStatusText"
                                               Grid.Column="0"
                                               Text="Java: Temurin 21"
                                               Foreground="#CCFFFFFF"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="RamStatusText"
                                               Grid.Column="1"
                                               Text="RAM: (checking)"
                                               Foreground="#CCFFFFFF"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- RAM selector -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="RAM:"
                                               Foreground="#CCFFFFFF"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <ComboBox x:Name="RamComboBox"
                                              Grid.Column="1"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              Height="32"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="RamComboBox_SelectionChanged"/>
                                </Grid>

                                <!-- RAM requirements -->
                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock Text="Minimum: 5 GB RAM"
                                               Foreground="#CCFFFFFF"
                                               FontSize="12"/>
                                    <TextBlock Text="Recommended: 7 GB RAM"
                                               Foreground="#CCFFFFFF"
                                               FontSize="12"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Console button -->
                                <Button x:Name="ToggleConsoleButton"
                                        Grid.Row="4"
                                        Margin="0,10,0,0"
                                        Content="Show Console"
                                        Style="{StaticResource PillActionButtonStyle}"
                                        Click="ToggleConsoleButton_Click"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- Right side -->
                <Grid Grid.Column="1"/>

                <!-- Console Drawer -->
                <Border x:Name="ConsoleDrawer"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        Width="520"
                        Margin="0"
                        Background="#E0101420"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12"
                        Visibility="Collapsed"
                        RenderTransformOrigin="1,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ConsoleDrawerTransform" X="540"/>
                    </Border.RenderTransform>

                    <Grid x:Name="ConsolePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Console"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBox x:Name="LogBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>